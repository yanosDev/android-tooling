      "Bash(./gradlew *:bundle*)",
      "Bash(./gradlew *:check*)",
      "Bash(./gradlew *:dependencies)",
      "Bash(./gradlew *:install*)",
      "Bash(./gradlew *:lint*)",
      "Bash(./gradlew *:test*)",
      "Bash(./gradlew assemble*)",
      "Bash(./gradlew build)",
      "Bash(./gradlew bundle*)",
      "Bash(./gradlew check*)",
      "Bash(./gradlew clean)",
      "Bash(./gradlew dependencies)",
