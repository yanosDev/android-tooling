  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "enabled": true,
    "failIfUnavailable": true,
    "excludedCommands": [],
    "filesystem": {
      "allowRead": [
        ".",
        "~/.android",
        "~/.config/jgit",
        "~/.gitconfig",
        "~/.gitignore_global",
        "~/.gradle/.tmp",
        "~/.gradle/android",
        "~/.gradle/caches",
        "~/.gradle/daemon",
        "~/.gradle/init.d",
        "~/.gradle/native",
        "~/.gradle/notifications",
        "~/.gradle/wrapper/dists",
        "~/Applications/Android Studio.app",
        "~/Library/Java"
      ],
      "allowWrite": [
        "/tmp",
        "/var/folders",
        "~/.android",
        "~/.config/jgit",
        "~/.gradle/.tmp",
        "~/.gradle/android",
        "~/.gradle/caches",
        "~/.gradle/daemon",
        "~/.gradle/native",
        "~/.gradle/notifications",
        "~/.gradle/wrapper/dists"
      ],
      "denyRead": [
        "~"
      ],
      "denyWrite": [
        "./.claude/settings.json",
        "./.claude/settings.local.json",
        "./.mcp.json",
        "gradle/wrapper"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "artifactory.chrono24.net"
      ],
      "deniedDomains": []
    }
  }
